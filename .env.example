# Public values used by the browser bundle (set these in deployment build variables)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets (configure in Cloudflare Workers secrets; do not prefix with VITE_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
EMAILJS_PRIVATE_KEY=
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
