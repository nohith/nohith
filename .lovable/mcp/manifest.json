{
  "version": 1,
  "sdk_version": "3.0.5",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "nohith-raj-portfolio",
      "version": "0.1.0",
      "title": "Nohith Raj Portfolio"
    },
    "tools": [
      {
        "name": "get_portfolio",
        "title": "Get portfolio information",
        "description": "Return Nohith Raj K's public portfolio details for a chosen section, or everything.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "section": {
              "default": "all",
              "description": "Which part of the portfolio to return.",
              "type": "string",
              "enum": [
                "overview",
                "education",
                "experience",
                "skills",
                "services",
                "projects",
                "contact",
                "all"
              ]
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
